# Public-safe backend configuration. Copy the values you need into your
# deployment platform's environment settings; do not commit a real .env file.
APP_NAME=SpamChecker
APP_VERSION=1.0.0
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_DIR=models
MAX_BATCH_ROWS=1000
MAX_TEXT_LENGTH=20000
DEFAULT_SPAM_THRESHOLD=0.50
SSE_HEARTBEAT_SEC=1
LOG_LEVEL=INFO
